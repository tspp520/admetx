[Unit]
Description=admetx LDAP auth sidecar (dev)
After=network.target

[Service]
User=aiuser
WorkingDirectory=/export/projects/admetx/admetx-auth
Environment=PORT=8033
ExecStart=/export/projects/admetx/admetx-auth/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8033
Restart=on-failure
RestartSec=3
StandardOutput=append:/export/projects/admetx/logs/auth-dev.log
StandardError=append:/export/projects/admetx/logs/auth-dev.log

[Install]
WantedBy=multi-user.target
